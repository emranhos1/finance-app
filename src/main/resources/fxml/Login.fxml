<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!-- The ONE Login layout for every theme. Sizes, fonts and spacing live in main.css (".login-*" rules), colours come
     from the theme's -c-* variables. Do not add a themed copy of this file and do not put sizes or fonts inline here. -->
<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.LoginController"
      alignment="CENTER" spacing="8" styleClass="login-card">

    <!-- shown only when a newer release exists -->
    <VBox fx:id="updateBanner" spacing="4" visible="false" managed="false" styleClass="update-banner">
        <Label fx:id="updateLabel" wrapText="true"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="updateButton" text="Update now" styleClass="btn-primary" onAction="#handleUpdate"/>
            <Hyperlink text="What's new?" onAction="#handleShowReleaseNotes"/>
        </HBox>
        <!-- fixed height, the window is not resizable and the bar gets squeezed without it -->
        <ProgressBar fx:id="updateProgress" maxWidth="Infinity" minHeight="14" prefHeight="14" visible="false" managed="false"/>
    </VBox>

    <ImageView fitWidth="48" fitHeight="48" preserveRatio="true">
        <Image url="@/images/logo.png" />
    </ImageView>

    <Label text="Daily Finance Management System" styleClass="app-title, login-title" textAlignment="CENTER" wrapText="true"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Username" styleClass="login-label"/>
        <TextField fx:id="usernameField" promptText="Enter your username" styleClass="login-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Password" styleClass="login-label"/>
        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Login" defaultButton="true" styleClass="btn-primary, login-btn" onAction="#handleLogin" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Register" styleClass="btn-secondary, login-btn" onAction="#handleRegister" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <Hyperlink text="Forgot Password?" styleClass="login-link" onAction="#handleForgotPassword"/>

    <Label fx:id="versionLabel" styleClass="version-label"/>
</VBox>
