<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.LoginController"
      alignment="CENTER" spacing="8" style="-fx-padding: 15 45 15 45;">

    <!-- Shown only when GitHub has a newer release (checked in the background on open) -->
    <VBox fx:id="updateBanner" spacing="4" visible="false" managed="false"
          style="-fx-background-color: #FFF4D6; -fx-border-color: #E8C46A; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;">
        <Label fx:id="updateLabel" wrapText="true" style="-fx-font-weight: bold;"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="updateButton" text="Update now" styleClass="btn-primary" onAction="#handleUpdate"/>
            <Hyperlink text="What's new?" onAction="#handleShowReleaseNotes"/>
        </HBox>
        <!-- fixed height: the login window is not resizable, so without it the bar gets squeezed to a thin line -->
        <ProgressBar fx:id="updateProgress" maxWidth="Infinity" minHeight="14" prefHeight="14" visible="false" managed="false"/>
    </VBox>

    <ImageView fitWidth="48" fitHeight="48" preserveRatio="true">
        <Image url="@/images/logo.png" />
    </ImageView>

    <Label text="Daily Finance Management System" style="-fx-font-size: 17; -fx-font-weight: bold;" styleClass="app-title" textAlignment="CENTER" wrapText="true"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Username" prefWidth="72"/>
        <TextField fx:id="usernameField" promptText="Enter your username" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Password" prefWidth="72"/>
        <PasswordField fx:id="passwordField" promptText="Enter your password" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Login" style="-fx-padding: 8; -fx-font-size: 13;" styleClass="btn-primary" onAction="#handleLogin"/>
        <Button text="Register" style="-fx-padding: 8; -fx-font-size: 13;" styleClass="btn-secondary" onAction="#handleRegister"/>
    </HBox>

    <Hyperlink text="Forgot Password?" onAction="#handleForgotPassword"/>

    <Label fx:id="versionLabel" style="-fx-font-size: 10; -fx-text-fill: #8AA69C;"/>
</VBox>
