<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.controller.AdminPanelController"
            fitToWidth="true">
<VBox spacing="16" style="-fx-padding: 15;">

    <Label text="Admin Panel - User Management" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Button text="Activate User" onAction="#handleActivateUser" style="-fx-padding: 8;" styleClass="btn-primary"/>
        <Button text="Deactivate User" onAction="#handleDeactivateUser" style="-fx-padding: 8;" styleClass="btn-accent"/>
    </HBox>

    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" minWidth="10"/>
            <ColumnConstraints percentWidth="50" minWidth="10"/>
        </columnConstraints>

        <TableView fx:id="usersTable" fixedCellSize="32" prefHeight="200" minHeight="200" maxHeight="200"
                   maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200"/>
                <TableColumn fx:id="roleColumn" text="Role" prefWidth="100"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
            </columns>
        </TableView>

        <VBox styleClass="summary-card" spacing="10" minWidth="0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Set Security Question (for selected user)" styleClass="card-title"/>
            <Label text="Needed so the selected user can self-service reset their password from the Login screen's Forgot Password link. Select a user in the table above first."
                   styleClass="card-label" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="securityQuestionField" promptText="Security question" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="securityAnswerField" promptText="Answer" HBox.hgrow="ALWAYS"/>
                <Button text="Set" onAction="#handleSetSecurityQuestion" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </GridPane>

    <Label text="Backup &amp; Restore" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33" minWidth="10"/>
            <ColumnConstraints percentWidth="33.33" minWidth="10"/>
            <ColumnConstraints percentWidth="33.33" minWidth="10"/>
        </columnConstraints>

        <VBox styleClass="summary-card" spacing="12" minWidth="0" minHeight="230"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Local Backup &amp; Restore" styleClass="card-title"/>
            <Label text="Export your data to a .sql file on this computer, or restore your database from a previously saved file."
                   styleClass="card-label" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="exportLocalBtn" text="Export to Local" onAction="#handleExportLocal" styleClass="btn-primary"/>
                <Button fx:id="importLocalBtn" text="Import from Local" onAction="#handleImportLocal" styleClass="btn-secondary"/>
                <ProgressIndicator fx:id="localProgress" prefWidth="22" prefHeight="22"/>
            </HBox>

            <Label fx:id="localStatusLabel" text="" wrapText="true"/>
        </VBox>

        <VBox styleClass="summary-card" spacing="12" minWidth="0" minHeight="230"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Google Drive Backup &amp; Restore" styleClass="card-title"/>
            <Label text="Connect your Google Drive account to upload a backup or restore the most recent one from the cloud."
                   styleClass="card-label" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="connectDriveBtn" text="Connect Google Drive" onAction="#handleConnectDrive" styleClass="btn-secondary"/>
                <Button fx:id="disconnectDriveBtn" text="Logout Google Drive" onAction="#handleDisconnectDrive" styleClass="btn-secondary" disable="true"/>
            </HBox>

            <!-- FlowPane: the buttons wrap onto a second line in a narrow card instead of cutting their text -->
            <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                <Button fx:id="uploadDriveBtn" text="Upload to Google Drive" onAction="#handleUploadDrive" styleClass="btn-primary" disable="true"/>
                <Button fx:id="downloadDriveBtn" text="Download &amp; Import from Google Drive" onAction="#handleDownloadDrive" styleClass="btn-secondary" disable="true"/>
                <ProgressIndicator fx:id="driveProgress" prefWidth="22" prefHeight="22"/>
            </FlowPane>

            <Label fx:id="driveStatusLabel" text="" wrapText="true"/>
        </VBox>

        <VBox styleClass="summary-card" spacing="12" minWidth="0" minHeight="230"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Data Integrity" styleClass="card-title"/>
            <Label text="Checks that every account's balance matches its transaction history, and that no transaction points to a loan that no longer exists. Read-only - never changes any data."
                   styleClass="card-label" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="verifyDataBtn" text="Verify Data" onAction="#handleVerifyData" styleClass="btn-primary"/>
            </HBox>
            <TextArea fx:id="integrityReportArea" editable="false" wrapText="true" prefHeight="120"
                      managed="false" visible="false"/>
        </VBox>
    </GridPane>

</VBox>
</ScrollPane>