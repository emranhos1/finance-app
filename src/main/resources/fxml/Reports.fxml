<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import com.finance.controller.DateRangeField?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finance.controller.ReportsController"
            fitToWidth="true" styleClass="dash-scroll">
<VBox spacing="10" style="-fx-padding: 15;">

    <!-- Page-wide filters: every section below (summary, categories, balances, trend, account log)
         reloads as soon as one of these changes -->
    <HBox spacing="8" style="-fx-alignment: CENTER-LEFT;">
        <MenuButton fx:id="accountFilterMenuButton" text="All Accounts" prefWidth="170"/>
        <DateRangeField fx:id="filterDateRangeField"/>
        <ComboBox fx:id="filterRefTypeComboBox" prefWidth="130"/>
        <ComboBox fx:id="filterCategoryComboBox" prefWidth="170"/>
        <Button text="Clear" onAction="#handleClearFilters" styleClass="btn-secondary"/>
    </HBox>

    <HBox spacing="10">
        <VBox spacing="4" prefWidth="230" minWidth="210">
            <Label text="Summary" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <VBox style="-fx-border-color: #B7D9CE; -fx-padding: 10; -fx-background-color: #ffffff;" VBox.vgrow="ALWAYS">
            <GridPane hgap="30" vgap="8">
                <Label text="Total Income:"  GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="totalIncomeLabel"  text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label text="Total Expense:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="totalExpenseLabel" text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label text="Net Income:"    GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="netIncomeLabel"    text="৳ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            </GridPane>
            </VBox>
        </VBox>

        <HBox spacing="10" HBox.hgrow="ALWAYS">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Expense by Category" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                <TableView fx:id="expenseCategoryTable" minHeight="120" prefHeight="120">
                    <columns>
                        <TableColumn fx:id="expCategoryNameColumn"   text="Category" prefWidth="160"/>
                        <TableColumn fx:id="expCategoryAmountColumn" text="Amount"   prefWidth="120"/>
                    </columns>
                    <placeholder><Label text="No data"/></placeholder>
                </TableView>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Income by Category" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                <TableView fx:id="incomeCategoryTable" minHeight="120" prefHeight="120">
                    <columns>
                        <TableColumn fx:id="incCategoryNameColumn"   text="Category" prefWidth="160"/>
                        <TableColumn fx:id="incCategoryAmountColumn" text="Amount"   prefWidth="120"/>
                    </columns>
                    <placeholder><Label text="No data"/></placeholder>
                </TableView>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Account Balances" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
                <TableView fx:id="accountTable" minHeight="120" prefHeight="120">
                    <columns>
                        <TableColumn fx:id="accountNameColumn"    text="Account" prefWidth="120"/>
                        <TableColumn fx:id="accountTypeColumn"    text="Type"    prefWidth="80"/>
                        <TableColumn fx:id="accountBalanceColumn" text="Balance" prefWidth="110"/>
                    </columns>
                    <placeholder><Label text="No accounts"/></placeholder>
                </TableView>
            </VBox>
        </HBox>
    </HBox>

    <VBox spacing="4" style="-fx-border-color: #B7D9CE; -fx-padding: 10; -fx-background-color: #ffffff;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Income vs Expense Trend (Last 12 Months)" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Region style="-fx-background-color: #E74C3C; -fx-min-width: 10; -fx-min-height: 10; -fx-max-width: 10; -fx-max-height: 10; -fx-background-radius: 5;"/>
                <Label text="Income" style="-fx-font-size: 11;"/>
            </HBox>
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Region style="-fx-background-color: #F39C12; -fx-min-width: 10; -fx-min-height: 10; -fx-max-width: 10; -fx-max-height: 10; -fx-background-radius: 5;"/>
                <Label text="Expense" style="-fx-font-size: 11;"/>
            </HBox>
        </HBox>
        <LineChart fx:id="trendChart" minHeight="160" prefHeight="160" animated="false" legendVisible="false">
            <xAxis>
                <CategoryAxis fx:id="trendXAxis"/>
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="trendYAxis"/>
            </yAxis>
        </LineChart>
    </VBox>

    <HBox spacing="8" style="-fx-alignment: CENTER-LEFT;">
        <Label text="Account Log" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export CSV" onAction="#handleExportCSV" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="accountLogTable" minHeight="250" prefHeight="300">
        <columns>
            <TableColumn fx:id="logDateColumn"          text="Date"          prefWidth="100"/>
            <TableColumn fx:id="logChangeTypeColumn"    text="Change"        prefWidth="85"/>
            <TableColumn fx:id="logRefTypeColumn"       text="Reference"     prefWidth="85"/>
            <TableColumn fx:id="logAmountColumn"        text="Amount"        prefWidth="100"/>
            <TableColumn fx:id="logBalanceBeforeColumn" text="Before"        prefWidth="110"/>
            <TableColumn fx:id="logBalanceAfterColumn"  text="After"         prefWidth="110"/>
            <TableColumn fx:id="logNoteColumn"          text="Note"          minWidth="150"/>
        </columns>
        <placeholder><Label text="Select an account to view its log"/></placeholder>
    </TableView>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="logPrevPageBtn" text="◀ Prev" onAction="#handleLogPrevPage" styleClass="btn-secondary"/>
        <Label fx:id="logPageLabel" text="Page 1 of 1"/>
        <Button fx:id="logNextPageBtn" text="Next ▶" onAction="#handleLogNextPage" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Rows per page:"/>
        <ComboBox fx:id="logPageSizeComboBox" prefWidth="80"/>
    </HBox>

</VBox>
</ScrollPane>
