<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.AccountsController"
      spacing="10" styleClass="content-pane">

    <TabPane VBox.vgrow="ALWAYS">

        <!-- ===== TAB 1: Accounts ===== -->
        <Tab text="Accounts" closable="false">
            <HBox spacing="15" styleClass="tab-content">

                <VBox spacing="8" styleClass="form-pane">
                    <Label text="Account Name"/>
                    <TextField fx:id="nameField" promptText="Enter account name"/>

                    <Label text="Account Type"/>
                    <ComboBox fx:id="typeComboBox" maxWidth="Infinity"/>

                    <Label text="Initial Balance"/>
                    <TextField fx:id="balanceField" promptText="0.00"/>

                    <Label text="Maturity Date (optional — for DPS/FDR)"/>
                    <DatePicker fx:id="maturityDatePicker" maxWidth="Infinity"/>

                    <Label text="Installment Amount (optional)"/>
                    <TextField fx:id="installmentField" promptText="0.00"/>

                    <Label text="Low Balance Alert Threshold (optional)"/>
                    <TextField fx:id="lowBalanceThresholdField" promptText="e.g. 500 — warn when balance falls below this"/>

                    <!-- Add button: shown by default -->
                    <Button fx:id="accAddBtn" text="Add Account" onAction="#handleAddAccount" maxWidth="Infinity" styleClass="btn-primary"/>

                    <!-- Update/Delete/Cancel: hidden by default -->
                    <HBox fx:id="accEditButtons" spacing="8" managed="false" visible="false">
                        <Button text="Update" onAction="#handleUpdateAccount" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteAccount" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelAccount" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="accountsTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn"      text="ID"      prefWidth="50"/>
                        <TableColumn fx:id="nameColumn"    text="Name"    prefWidth="150"/>
                        <TableColumn fx:id="typeColumn"    text="Type"    prefWidth="90"/>
                        <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="110"/>
                        <TableColumn fx:id="maturityColumn"    text="Maturity Date" prefWidth="110"/>
                        <TableColumn fx:id="installmentColumn" text="Installment"   prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No accounts yet"/></placeholder>
                </TableView>
            </HBox>
        </Tab>

        <!-- ===== TAB 2: Account Types ===== -->
        <Tab text="Account Types" closable="false">
            <HBox spacing="15" styleClass="tab-content">

                <VBox spacing="8" styleClass="form-pane">
                    <Label text="Type Name"/>
                    <TextField fx:id="typeNameField" promptText="e.g. cash, bank, savings"/>

                    <!-- Add button: shown by default -->
                    <Button fx:id="typeAddBtn" text="Add Type" onAction="#handleAddType" maxWidth="Infinity" styleClass="btn-primary"/>

                    <!-- Update/Delete/Cancel: hidden by default -->
                    <HBox fx:id="typeEditButtons" spacing="8" managed="false" visible="false">
                        <Button text="Update" onAction="#handleUpdateType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="typesTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="typeIdColumn"   text="ID"   prefWidth="60"/>
                        <TableColumn fx:id="typeNameColumn" text="Name" prefWidth="240"/>
                    </columns>
                    <placeholder><Label text="No account types yet. Add some!"/></placeholder>
                </TableView>
            </HBox>
        </Tab>

    </TabPane>
</VBox>
