<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.finance.controller.TransferController"
      spacing="10" styleClass="content-pane">

    <TabPane VBox.vgrow="ALWAYS">

        <!-- transfer tab -->
        <Tab text="Transfer" closable="false">
            <HBox spacing="15" styleClass="tab-content">

                <VBox spacing="8" styleClass="form-pane">

                    <Label text="Date"/>
                    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>

                    <Label text="From Account"/>
                    <ComboBox fx:id="fromAccountComboBox" maxWidth="Infinity"/>

                    <Label text="To Account"/>
                    <ComboBox fx:id="toAccountComboBox" maxWidth="Infinity"/>

                    <Label text="Transfer Type"/>
                    <ComboBox fx:id="transferTypeComboBox" maxWidth="Infinity"/>

                    <Label text="Amount"/>
                    <TextField fx:id="amountField" promptText="0.00"/>

                    <Label text="Note"/>
                    <TextArea fx:id="noteArea" prefHeight="80" wrapText="true"/>

                    <Button fx:id="saveTransferBtn" text="Save Transfer"
                            onAction="#handleSaveTransfer" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox fx:id="txEditButtons" spacing="8" visible="false" managed="false">
                        <Button text="Update" onAction="#handleUpdateTransfer" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteTransfer" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelTransfer" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>

                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Transfer Type:"/>
                        <ComboBox fx:id="transferTypeFilterComboBox" prefWidth="160"/>
                        <Label text="Date:"/>
                        <DatePicker fx:id="dateFilter" prefWidth="140"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Account:"/>
                        <ComboBox fx:id="accountFilterComboBox" prefWidth="180"/>
                        <Button text="Clear" onAction="#handleClearFilters" styleClass="btn-secondary"/>
                    </HBox>
                    <TableView fx:id="transfersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="dateColumn"         text="Date"          prefWidth="95"/>
                            <TableColumn fx:id="typeColumn"         text="Type"          prefWidth="80"/>
                            <TableColumn fx:id="fromColumn"         text="From"          prefWidth="120"/>
                            <TableColumn fx:id="toColumn"           text="To"            prefWidth="120"/>
                            <TableColumn fx:id="transferTypeColumn" text="Transfer Type" prefWidth="110"/>
                            <TableColumn fx:id="amountColumn"       text="Amount"        prefWidth="90"/>
                            <TableColumn fx:id="noteColumn"         text="Note"          minWidth="150"/>
                        </columns>
                        <placeholder><Label text="No transfers yet"/></placeholder>
                    </TableView>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="trPrevPageBtn" text="◀ Prev" onAction="#handleTrPrevPage" styleClass="btn-secondary"/>
                        <Label fx:id="trPageLabel" text="Page 1 of 1"/>
                        <Button fx:id="trNextPageBtn" text="Next ▶" onAction="#handleTrNextPage" styleClass="btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Rows per page:"/>
                        <ComboBox fx:id="trPageSizeComboBox" prefWidth="80"/>
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

        <!-- transfer types tab -->
        <Tab text="Transfer Types" closable="false">
            <HBox spacing="15" styleClass="tab-content">

                <VBox spacing="8" styleClass="form-pane">
                    <Label text="Type Name"/>
                    <TextField fx:id="typeNameField" promptText="e.g. Savings, Bill Payment"/>

                    <Button fx:id="typeAddBtn" text="Add Type" onAction="#handleAddType" maxWidth="Infinity" styleClass="btn-primary"/>

                    <HBox fx:id="typeEditButtons" spacing="8" managed="false" visible="false">
                        <Button text="Update" onAction="#handleUpdateType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="Delete" onAction="#handleDeleteType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-accent"/>
                        <Button text="Cancel" onAction="#handleCancelType" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="typesTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="typeIdColumn"   text="ID"   prefWidth="60"/>
                        <TableColumn fx:id="typeNameColumn" text="Name" prefWidth="240"/>
                    </columns>
                    <placeholder><Label text="No transfer types yet. Add some!"/></placeholder>
                </TableView>
            </HBox>
        </Tab>

    </TabPane>
</VBox>
